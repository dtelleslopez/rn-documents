# Base URL of the documents server.
#
# Only variables prefixed with EXPO_PUBLIC_ reach the app, and Expo inlines them
# into the bundle, so never put secrets here.
#
# The emulator and a USB device both reach the host through
# `adb reverse tcp:8080 tcp:8080`, which keeps localhost working everywhere. Set
# this to the machine's LAN address instead if you prefer not to use adb.
EXPO_PUBLIC_API_BASE_URL=http://localhost:8080
